<!-- Offline compile check for Editor/ as its own assembly referencing the Code/ check (like s&box). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>SANDBOX</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TextToAnimation.EditorCompileCheck</AssemblyName>
    <NoWarn>1701;1702;1591;8632;CS8632</NoWarn>
    <SboxRoot Condition="'$(SboxRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\sbox</SboxRoot>
    <BaseIntermediateOutputPath>obj\editor\</BaseIntermediateOutputPath>
    <OutputPath>obj\out\editor\</OutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Sandbox.Internal.GlobalToolsNamespace" Static="true" />
    <Using Include="Sandbox.Internal.GlobalGameNamespace" Static="true" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\Editor\**\*.cs" Exclude="..\..\Editor\obj\**;..\..\Editor\Properties\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="CodeCompileCheck.csproj" />
    <Reference Include="$(SboxRoot)\bin\managed\Sandbox.System.dll" />
    <Reference Include="$(SboxRoot)\bin\managed\Sandbox.Engine.dll" />
    <Reference Include="$(SboxRoot)\bin\managed\Sandbox.Filesystem.dll" />
    <Reference Include="$(SboxRoot)\bin\managed\Sandbox.Reflection.dll" />
    <Reference Include="$(SboxRoot)\bin\managed\Sandbox.Mounting.dll" />
    <Reference Include="$(SboxRoot)\bin\managed\Sandbox.AppSystem.dll" />
    <Reference Include="$(SboxRoot)\bin\managed\Sandbox.Tools.dll" />
    <Reference Include="$(SboxRoot)\bin\managed\Sandbox.Compiling.dll" />
    <Reference Include="$(SboxRoot)\bin\managed\Sandbox.Bind.dll" />
    <Reference Include="$(SboxRoot)\bin\managed\SkiaSharp.dll" />
    <Reference Include="$(SboxRoot)\bin\managed\Sandbox.Event.dll" />
    <Reference Include="$(SboxRoot)\bin\managed\Facepunch.ActionGraphs.dll" />
    <Reference Include="$(SboxRoot)\bin\managed\Microsoft.AspNetCore.Components.dll" />
    <Reference Include="$(SboxRoot)\.vs\output\Base Editor Library.dll" />
    <Reference Include="$(SboxRoot)\.vs\output\Base Library.dll" />
  </ItemGroup>
</Project>
